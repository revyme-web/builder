{
  "name": "revyme",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"vite\" \"vite --config vite.sandbox.config.ts\" \"vite --config vite.preview.config.ts\"",
    "dev:standalone": "vite",
    "build": "vite build",
    "build:sandbox": "vite build --config vite.sandbox.config.ts",
    "build:preview": "vite build --config vite.preview.config.ts",
    "build:all": "npm run build && npm run build:sandbox && npm run build:preview",
    "preview": "concurrently \"vite preview --port 3333\" \"vite preview --config vite.sandbox.config.ts --port 5174\" \"vite preview --config vite.preview.config.ts --port 5175\"",
    "start": "npm run build:all && npm run preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "website-builder",
    "visual-editor",
    "no-code",
    "react",
    "nextjs",
    "framer-motion",
    "canvas",
    "design-tool",
    "code-generation"
  ],
  "author": "Revyme",
  "license": "AGPL-3.0-only",
  "description": "Revyme — a visual, code-first website builder. The React code is the document.",
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/standalone": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-slider": "^1.3.6",
    "@revyme/plugin-sdk": "^0.7.0",
    "@revyme/runtime": "^0.0.11",
    "@tiptap/extension-color": "^3.20.4",
    "@tiptap/extension-font-family": "^3.20.4",
    "@tiptap/extension-highlight": "^3.20.5",
    "@tiptap/extension-text-style": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "comlink": "^4.4.2",
    "flag-icons": "^7.5.0",
    "html-to-image": "^1.11.13",
    "jotai": "^2.18.1",
    "json-edit-react": "^1.29.0",
    "motion": "^12.38.0",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-social-icons": "^6.26.0",
    "react-window": "^2.2.7",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "svg-pathdata": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
